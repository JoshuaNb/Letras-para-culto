<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:m="using:WorshipStudio.Models" xmlns:controls="using:WorshipStudio.Controls"
 x:Class="WorshipStudio.MainWindow" Classes="studio-shell" Title="Worship Studio — Letras para culto" Width="1560" Height="980" MinWidth="1180" MinHeight="760" WindowStartupLocation="CenterScreen">
 <Grid RowDefinitions="28,44,*,42,24">
  <Border Background="{DynamicResource WsHeader}" BorderBrush="{DynamicResource WsBorder}" BorderThickness="0,0,0,1" Padding="8,0">
   <Grid ColumnDefinitions="Auto,*,Auto">
    <Menu x:Name="StudioMenu" VerticalAlignment="Center">
     <MenuItem Header="_Arquivo">
      <MenuItem x:Name="MenuNewSong" Header="Novo louvor…"/>
      <MenuItem x:Name="MenuImportSongs" Header="Importar letras…"/>
      <Separator/>
      <MenuItem x:Name="MenuBackup" Header="Salvar backup completo…"/>
      <MenuItem x:Name="MenuRestore" Header="Restaurar backup…"/>
      <Separator/>
      <MenuItem x:Name="MenuExportVideo" Header="Exportar vídeo MP4…"/>
      <Separator/>
      <MenuItem x:Name="MenuExit" Header="Sair"/>
     </MenuItem>
     <MenuItem Header="_Biblioteca">
      <MenuItem x:Name="MenuEditSong" Header="Editar louvor selecionado…"/>
      <MenuItem x:Name="MenuDeleteSong" Header="Excluir louvor selecionado…"/>
      <MenuItem x:Name="MenuAddSetlist" Header="Adicionar ao roteiro"/>
     </MenuItem>
     <MenuItem Header="_Projeção">
      <MenuItem x:Name="MenuOpenProjection" Header="Abrir ou fechar projeção"/>
      <Separator/>
      <MenuItem x:Name="MenuPreviousSlide" Header="Estrofe anterior"/>
      <MenuItem x:Name="MenuNextSlide" Header="Próxima estrofe"/>
      <Separator/>
      <MenuItem x:Name="MenuHideLyrics" Header="Ocultar ou mostrar letra"/>
      <MenuItem x:Name="MenuBlackout" Header="Ativar ou desativar tela preta"/>
     </MenuItem>
     <MenuItem Header="_Ferramentas">
      <MenuItem x:Name="MenuAnimations" Header="Galeria de animações…"/>
      <MenuItem x:Name="MenuConnections" Header="Conexões e Holyrics"/>
      <MenuItem x:Name="MenuReceivedFiles" Header="Arquivos recebidos do celular…"/>
      <Separator/>
      <MenuItem x:Name="MenuPreferences" Header="Preferências"/>
     </MenuItem>
     <MenuItem Header="A_juda">
      <MenuItem x:Name="MenuHelp" Header="Guia de operação e atalhos"/>
      <MenuItem x:Name="MenuUpdates" Header="Verificar atualizações…"/>
     </MenuItem>
    </Menu>
    <TextBlock Grid.Column="2" Text="LETRAS PARA CULTO · PROJETO LOCAL" Classes="subtle" FontSize="9" LetterSpacing="1" VerticalAlignment="Center" Margin="12,0"/>
   </Grid>
  </Border>
  <Border Grid.Row="1" Background="{DynamicResource WsSurface}" BorderBrush="{DynamicResource WsBorder}" BorderThickness="0,0,0,1" Padding="12,5">
   <Grid ColumnDefinitions="240,*,Auto">
    <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
     <Border Background="{DynamicResource WsAccent}" CornerRadius="3" Width="26" Height="26"><TextBlock Text="W" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource WsAccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <TextBlock Text="WORSHIP STUDIO" FontWeight="SemiBold" FontSize="12" LetterSpacing="1.1" VerticalAlignment="Center"/>
    </StackPanel>
    <TextBlock x:Name="UpdateStatus" Grid.Column="1" Text="Operação offline · arquivos locais" Classes="muted" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="12,0"/>
    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
     <TextBlock Text="TEMA" Classes="caption" VerticalAlignment="Center" Margin="0,0,2,0"/>
     <ComboBox x:Name="ThemeCombo" Width="136" MinHeight="28" AutomationProperties.Name="Tema do programa"/>
     <Border Width="1" Background="{DynamicResource WsBorder}" Margin="5,2"/>
     <Button x:Name="UpdateButton" Content="Atualizações" Classes="flat" ToolTip.Tip="Verificar e instalar novas versões pelo aplicativo"/>
     <Button x:Name="ExportButton" Content="Exportar MP4" Classes="primary"/>
     <Button x:Name="HelpButton" Content="?" Width="30" ToolTip.Tip="Guia de operação e atalhos"/>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="2" ColumnDefinitions="240,4,*,4,318" RowDefinitions="*,5,252">
   <Border Grid.RowSpan="3" Background="{DynamicResource WsPanel}">
    <Grid RowDefinitions="32,Auto,Auto,*,Auto,Auto,Auto">
     <Border Background="{DynamicResource WsSurface}" BorderBrush="{DynamicResource WsBorder}" BorderThickness="0,0,0,1" Padding="12,8"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="BIBLIOTECA" Classes="caption"/><TextBlock Grid.Column="1" Text="LOCAL" FontSize="9" Classes="subtle"/></Grid></Border>
     <ComboBox x:Name="LibraryMode" Grid.Row="1" Margin="10,10,10,8" SelectedIndex="0"><ComboBoxItem Content="Todos os louvores"/><ComboBoxItem Content="Roteiro do culto"/></ComboBox>
     <TextBox x:Name="SearchBox" Grid.Row="2" Watermark="Buscar título ou letra…" Margin="10,0,10,8"/>
     <ListBox x:Name="LibraryList" Grid.Row="3" SelectionMode="Single" Margin="4,0">
      <ListBox.ItemTemplate><DataTemplate DataType="m:Song"><Grid ColumnDefinitions="12,*" Margin="0,2"><Border Background="{DynamicResource WsClipAccent}" CornerRadius="1" Margin="0,2,9,2"/><StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="12"/><TextBlock Text="{Binding Artist}" FontSize="10" Classes="muted" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <StackPanel Grid.Row="4" Spacing="6" Margin="10,10,10,0">
      <TextBlock x:Name="LibraryCount" Classes="muted" FontSize="10" Margin="2,0,0,4"/>
      <Grid ColumnDefinitions="*,*"><Button x:Name="NewButton" Content="+ Novo louvor" Classes="primary" Margin="0,0,3,0" FontSize="11"/><Button x:Name="ImportButton" Grid.Column="1" Content="Importar" Margin="3,0,0,0"/></Grid>
      <Grid ColumnDefinitions="*,*"><Button x:Name="EditButton" Content="Editar" Margin="0,0,3,0"/><Button x:Name="DeleteButton" Grid.Column="1" Content="Excluir" Margin="3,0,0,0"/></Grid>
      <Button x:Name="AddSetButton" Content="+ Adicionar ao roteiro" HorizontalAlignment="Stretch"/>
     </StackPanel>
     <StackPanel Grid.Row="5" x:Name="SetlistTools" Orientation="Horizontal" Spacing="5" Margin="10,6,10,0" IsVisible="False"><Button x:Name="SetUpButton" Content="↑"/><Button x:Name="SetDownButton" Content="↓"/><Button x:Name="SetRemoveButton" Content="Remover"/></StackPanel>
     <TextBlock Grid.Row="6" Text="Um clique prepara. Duplo clique projeta." FontSize="10" Classes="muted" TextWrapping="Wrap" Margin="12,12,10,12"/>
    </Grid>
   </Border>
   <GridSplitter Grid.Column="1" Grid.RowSpan="3" ResizeDirection="Columns" Background="{DynamicResource WsBorder}"/>
   <Grid Grid.Column="2" RowDefinitions="35,*,38,40" Margin="8,0,8,0">
    <Border BorderBrush="{DynamicResource WsBorder}" BorderThickness="0,0,0,1" Padding="5,4"><Grid ColumnDefinitions="*,Auto"><Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center"><TextBlock x:Name="SelectedTitle" Text="Selecione um louvor" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="SelectedArtist" Grid.Column="1" Classes="muted" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="170" Margin="8,0,0,0"/></Grid><TextBlock Grid.Column="1" Text="16:9" Classes="subtle" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/></Grid></Border>
    <Grid Grid.Row="1" ColumnDefinitions="190,8,*" Margin="0,7,0,0">
     <Border Background="{DynamicResource WsSurface}" BorderBrush="{DynamicResource WsBorder}" BorderThickness="1">
      <Grid RowDefinitions="28,108,Auto,*">
       <Border Background="{DynamicResource WsTrackHeader}" Padding="9,7"><TextBlock Text="FONTE · PRÉVIA" Classes="caption" FontSize="9"/></Border>
       <Border Grid.Row="1" Background="Black" ClipToBounds="True"><controls:AspectRatioPanel><ContentControl x:Name="PreviewHost"/></controls:AspectRatioPanel></Border>
       <TextBlock x:Name="PreviewPosition" Grid.Row="2" Text="Nenhuma estrofe selecionada" Classes="muted" FontSize="10" Margin="9,9,9,0" TextWrapping="Wrap"/>
       <StackPanel Grid.Row="3" VerticalAlignment="Bottom" Spacing="7" Margin="9,12,9,10"><TextBlock Text="PREPARAR A PRÓXIMA" Classes="caption" FontSize="9"/><TextBlock Text="Selecione uma estrofe na trilha abaixo. Projetar envia a prévia para a saída ao vivo." Classes="muted" FontSize="10" TextWrapping="Wrap"/></StackPanel>
      </Grid>
     </Border>
     <Grid Grid.Column="2" RowDefinitions="28,*,25">
      <Border Background="{DynamicResource WsTrackHeader}" BorderBrush="{DynamicResource WsBorder}" BorderThickness="1,1,1,0" Padding="9,7"><Grid ColumnDefinitions="*,Auto"><TextBlock x:Name="LiveLabel" Text="SAÍDA FECHADA" FontSize="10" Foreground="{DynamicResource WsLive}" FontWeight="SemiBold" LetterSpacing="0.8"/><TextBlock Grid.Column="1" Text="PROGRAMA" Classes="subtle" FontSize="9"/></Grid></Border>
      <Border Grid.Row="1" BorderBrush="{DynamicResource WsBorder}" BorderThickness="1" Background="Black" ClipToBounds="True"><controls:AspectRatioPanel><ContentControl x:Name="LivePreviewHost"/></controls:AspectRatioPanel></Border>
      <TextBlock x:Name="LiveSummary" Grid.Row="2" Text="Abra a projeção para começar" Classes="muted" FontSize="10" Margin="3,6,0,0" TextTrimming="CharacterEllipsis"/>
     </Grid>
    </Grid>
    <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="0,4,0,0">
     <Button x:Name="PrevButton" Content="←" Width="32" Margin="0,0,4,0" ToolTip.Tip="Estrofe anterior · seta esquerda"/>
     <Button x:Name="NextButton" Grid.Column="1" Content="Próxima →" ToolTip.Tip="Seta direita ou espaço"/>
     <Button x:Name="ReplayButton" Grid.Column="2" Content="Repetir prévia" Classes="flat" ToolTip.Tip="Recomeçar a animação na prévia" Margin="4,0,0,0" FontSize="10"/>
     <Button x:Name="HideButton" Grid.Column="4" Content="Ocultar letra" Margin="4,0" ToolTip.Tip="Atalho L" FontSize="11"/>
     <Button x:Name="BlackButton" Grid.Column="5" Content="Tela preta" Classes="danger" ToolTip.Tip="Atalho B" FontSize="11"/>
    </Grid>
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,4,0,5">
     <Button x:Name="OpenProjectionButton" Content="Abrir projeção" HorizontalAlignment="Left"/>
     <Button x:Name="SendButton" Grid.Column="1" Content="Projetar estrofe →" Classes="primary"/>
    </Grid>
   </Grid>
   <GridSplitter Grid.Column="2" Grid.Row="1" ResizeDirection="Rows" Background="{DynamicResource WsBorder}"/>
   <Border Grid.Column="2" Grid.Row="2" Background="{DynamicResource WsTimelineBg}">
    <Grid RowDefinitions="31,*,86">
     <Border Background="{DynamicResource WsSurface}" BorderBrush="{DynamicResource WsBorder}" BorderThickness="0,0,0,1" Padding="10,8"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="SEQUÊNCIA DO CULTO" Classes="caption"/><TextBlock x:Name="TimelinePosition" Grid.Column="1" Text="PRÉVIA — · AO VIVO —" FontSize="10" Foreground="{DynamicResource WsClipAccent}" FontWeight="SemiBold"/></Grid></Border>
     <Grid Grid.Row="1" ColumnDefinitions="77,*">
      <Border Background="{DynamicResource WsTrackHeader}" BorderBrush="{DynamicResource WsBorder}" BorderThickness="0,0,1,1" Padding="9,10"><StackPanel Spacing="5"><TextBlock Text="L1" Foreground="{DynamicResource WsClipAccent}" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="LETRAS" Classes="caption" FontSize="8"/><TextBlock Text="Estrofes" Classes="muted" FontSize="9"/></StackPanel></Border>
      <Border Grid.Column="1" BorderBrush="{DynamicResource WsBorder}" BorderThickness="0,0,0,1"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="7,8"><WrapPanel x:Name="SlidesPanel" Orientation="Horizontal"/></ScrollViewer></Border>
     </Grid>
     <Grid Grid.Row="2" ColumnDefinitions="77,*">
      <Border Background="{DynamicResource WsTrackHeader}" BorderBrush="{DynamicResource WsBorder}" BorderThickness="0,0,1,0" Padding="9,8"><StackPanel Spacing="3"><TextBlock Text="R1" Foreground="{DynamicResource WsSetlistText}" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="ROTEIRO" Classes="caption" FontSize="8"/></StackPanel></Border>
      <Grid Grid.Column="1" RowDefinitions="Auto,*"><TextBlock x:Name="SetlistTimelineSummary" Text="Adicione louvores ao roteiro para organizar o culto." Classes="muted" FontSize="9" Margin="9,4,7,0" TextTrimming="CharacterEllipsis"/><ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="7,3,7,5"><StackPanel x:Name="SetlistTimelinePanel" Orientation="Horizontal" Spacing="5"/></ScrollViewer></Grid>
     </Grid>
    </Grid>
   </Border>
   <GridSplitter Grid.Column="3" Grid.RowSpan="3" ResizeDirection="Columns" Background="{DynamicResource WsBorder}"/>
   <Border Grid.Column="4" Grid.RowSpan="3" Background="{DynamicResource WsPanel}">
    <Grid RowDefinitions="32,*">
     <Border Background="{DynamicResource WsSurface}" BorderBrush="{DynamicResource WsBorder}" BorderThickness="0,0,0,1" Padding="12,8"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="INSPETOR" Classes="caption"/><TextBlock Grid.Column="1" Text="CENA E SAÍDA" Classes="subtle" FontSize="9"/></Grid></Border>
     <Grid Grid.Row="1">
    <TabControl x:Name="InspectorTabs" Margin="5,0,5,0">
     <TabItem Header="Cena">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
       <StackPanel Spacing="10" Margin="8,12,8,18">
        <TextBlock Text="SAÍDA DE VÍDEO" Classes="caption"/>
        <ComboBox x:Name="MonitorCombo"/>
        <TextBlock Text="A projeção abre em tela cheia no monitor escolhido. F11 alterna a janela; Esc sai da tela cheia." FontSize="10" Foreground="{DynamicResource WsMuted}" TextWrapping="Wrap"/>
        <Border Height="1" Background="{DynamicResource WsBorder}" Margin="0,4"/>
        <TextBlock Text="FUNDO &amp; MOVIMENTO" Classes="caption"/>
        <ComboBox x:Name="BackgroundCombo"/>
        <Button x:Name="MediaButton" Content="Escolher imagem ou vídeo…" HorizontalAlignment="Stretch"/>
        <TextBlock x:Name="MediaLabel" Text="Efeito procedural · sem arquivo externo" FontSize="10" Foreground="{DynamicResource WsMuted}" TextWrapping="Wrap" MaxLines="2"/>
        <Button x:Name="RestartVideoButton" Content="Reiniciar vídeo do fundo" HorizontalAlignment="Stretch"/>
        <TextBlock x:Name="BackgroundPlaybackStatus" Text="Fundos animados locais · sem internet" FontSize="10" Classes="muted" TextWrapping="Wrap"/>
        <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Escurecer fundo"/><TextBlock x:Name="DimValue" Grid.Column="1" Classes="muted"/></Grid><Slider x:Name="DimSlider" Minimum="0" Maximum="1" Value="0.35"/>
        <TextBlock Text="Velocidade do movimento"/><Slider x:Name="SpeedSlider" Minimum="0" Maximum="4" Value="1"/>
        <Grid ColumnDefinitions="*,*"><StackPanel Margin="0,0,5,0" Spacing="5"><TextBlock Text="Cor do efeito" FontSize="10"/><controls:ColorField x:Name="AccentField" Value="#48DCC4" Caption="Cor do efeito"/></StackPanel><StackPanel Grid.Column="1" Margin="5,0,0,0" Spacing="5"><TextBlock Text="Cor do fundo" FontSize="10"/><controls:ColorField x:Name="BackgroundColorField" Value="#08121F" Caption="Cor do fundo"/></StackPanel></Grid>
        <Border Height="1" Background="{DynamicResource WsBorder}" Margin="0,4"/>
        <TextBlock Text="TIPOGRAFIA DA LETRA" Classes="caption"/>
        <ComboBox x:Name="FontCombo" MaxDropDownHeight="260" AutomationProperties.Name="Fonte da letra">
         <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontFamily="{Binding}" FontSize="15" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <CheckBox x:Name="BoldCheck" Content="Negrito" FontWeight="Bold" IsChecked="True"/>
        <Grid ColumnDefinitions="*,*"><StackPanel Margin="0,0,5,0" Spacing="5"><TextBlock Text="Tamanho (1080p)" FontSize="10"/><NumericUpDown x:Name="FontSizeInput" Minimum="24" Maximum="140" Value="64" Increment="2"/></StackPanel><StackPanel Grid.Column="1" Margin="5,0,0,0" Spacing="5"><TextBlock Text="Cor da letra" FontSize="10"/><controls:ColorField x:Name="TextColorField" Value="#FFFFFF" Caption="Cor da letra"/></StackPanel></Grid>
        <Border Background="#101216" CornerRadius="6" Padding="10"><TextBlock x:Name="FontSample" Text="Adoração · Aa Bb Cc" FontSize="18" TextWrapping="Wrap" HorizontalAlignment="Center"/></Border>
        <TextBlock Text="Posição vertical"/><Slider x:Name="TextYSlider" Minimum="0.1" Maximum="0.9" Value="0.5"/>
        <Border Height="1" Background="{DynamicResource WsBorder}" Margin="0,4"/>
        <TextBlock Text="ANIMAÇÕES DAS LETRAS" Classes="caption"/>
        <Button x:Name="AnimationGalleryButton" Content="Galeria de animações  ↗" Classes="primary" HorizontalAlignment="Stretch" FontSize="11"/>
        <TextBlock x:Name="PresetSummary" Text="Entrada clássica" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource WsAccentLabel}"/>
        <CheckBox x:Name="PresetModeCheck" Content="Usar animação granular"/>
        <StackPanel x:Name="LegacyEntrancePanel" Spacing="10">
        <TextBlock Text="Entrada da letra" FontSize="11"/>
        <ComboBox x:Name="TransitionCombo" AutomationProperties.Name="Animação de entrada"/>
        <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Duração da transição"/><TextBlock x:Name="DurationValue" Grid.Column="1" Classes="muted"/></Grid><Slider x:Name="DurationSlider" Minimum="0" Maximum="3" Value="0.6"/>
        </StackPanel>
        <Button x:Name="ReplayInspectorButton" Content="Testar animação na prévia" HorizontalAlignment="Stretch"/>
        <StackPanel x:Name="LegacyMotionPanel" Spacing="10">
        <TextBlock Text="Animação contínua" FontSize="11"/>
        <ComboBox x:Name="LetterAnimationCombo" AutomationProperties.Name="Animação contínua da letra"/>
        <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Velocidade da letra" FontSize="11"/><TextBlock x:Name="LetterSpeedValue" Grid.Column="1" Classes="muted"/></Grid>
        <Slider x:Name="LetterSpeedSlider" Minimum="0.2" Maximum="3" Value="1"/>
        <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Intensidade da animação" FontSize="11"/><TextBlock x:Name="LetterIntensityValue" Grid.Column="1" Classes="muted"/></Grid>
        <Slider x:Name="LetterIntensitySlider" Minimum="0" Maximum="1" Value="0.5"/>
        <TextBlock Text="Combine uma entrada com um efeito contínuo. A velocidade da letra é independente do fundo. As animações também aparecem na projeção e no MP4." TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource WsMuted}"/>
        </StackPanel>
        <Grid ColumnDefinitions="*,*"><Button x:Name="SaveStyleButton" Content="Salvar cena" Margin="0,0,4,0"/><Button x:Name="LoadStyleButton" Grid.Column="1" Content="Carregar" Margin="4,0,0,0"/></Grid>
        <Border Height="1" Background="{DynamicResource WsBorder}" Margin="0,4"/>
        <TextBlock Text="REAÇÃO AO ÁUDIO" Classes="caption"/>
        <ToggleSwitch x:Name="AudioToggle" Content="Sincronizar efeitos"/>
        <ComboBox x:Name="AudioSourceCombo" SelectedIndex="0"><ComboBoxItem Content="Som do computador (loopback)"/><ComboBoxItem Content="Entrada padrão / microfone"/></ComboBox>
        <ProgressBar x:Name="AudioMeter" Minimum="0" Maximum="1" Height="5" Foreground="{DynamicResource WsAccent}"/>
        <TextBlock Text="Sensibilidade" FontSize="11"/><Slider x:Name="GainSlider" Minimum="0.5" Maximum="10" Value="3"/>
        <Button x:Name="BeatButton" Content="Pulso manual" HorizontalAlignment="Stretch"/>
       </StackPanel>
      </ScrollViewer>
     </TabItem>
     <TabItem Header="Conexões">
      <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8,12,8,18" Spacing="12">
       <TextBlock Text="CONTROLE PELO CELULAR" Classes="caption"/>
       <TextBlock Text="No APK Letras para culto — Controle, informe o endereço do PC e o código abaixo. PC e celular precisam estar na mesma rede Wi-Fi. O navegador também continua disponível pelo link completo." TextWrapping="Wrap" Foreground="{DynamicResource WsMuted}" FontSize="11"/>
       <NumericUpDown x:Name="RemotePortInput" Minimum="1024" Maximum="65535" Value="8765" FormatString="0"/>
       <Button x:Name="RemoteButton" Content="Iniciar controle remoto" Classes="primary" HorizontalAlignment="Stretch"/>
       <Border Background="{DynamicResource WsInput}" BorderBrush="{DynamicResource WsBorder}" BorderThickness="1" CornerRadius="5" Padding="12"><StackPanel Spacing="5">
        <TextBlock Text="PAREAMENTO COM O APK" Classes="caption"/>
        <TextBlock x:Name="PairingCodeLabel" Text="— — — — — —" FontSize="27" FontWeight="SemiBold" LetterSpacing="3" Foreground="{DynamicResource WsAccentLabel}"/>
        <TextBlock x:Name="PairingStatusLabel" Text="Inicie o controle para gerar o código." Classes="muted" TextWrapping="Wrap" FontSize="10"/>
       </StackPanel></Border>
       <TextBox x:Name="RemoteHostAddress" IsReadOnly="True" Watermark="Endereço do PC para o APK" AutomationProperties.Name="Endereço do PC para o APK"/>
       <Button x:Name="DownloadApkButton" Content="Baixar APK para Android…" HorizontalAlignment="Stretch"/>
       <TextBox x:Name="RemoteAddress" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" Text="Controle remoto desligado"/>
       <Button x:Name="CopyRemoteButton" Content="Copiar endereço"/>
       <Button x:Name="ReceivedFilesButton" Content="Arquivos recebidos do celular…" HorizontalAlignment="Stretch"/>
       <TextBlock x:Name="ReceivedFilesSummary" Text="Envie arquivos pelo APK ou pelo navegador após conectar. Até 512 MB por arquivo." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource WsMuted}"/>
       <TextBlock Text="Se o Windows solicitar, permita o acesso à rede privada. O controle usa apenas a rede local." TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource WsMuted}"/>
       <Border Height="1" Background="{DynamicResource WsBorder}" Margin="0,8"/>
       <TextBlock Text="HOLYRICS · API SERVER" Classes="caption"/>
       <TextBlock Text="Baixe letras e estrofes da biblioteca do Holyrics instalado neste PC ou na rede. Ative o API Server no Holyrics e crie um token com leitura de GetSongs e GetLyrics. Depois de importar, as letras ficam disponíveis offline." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource WsMuted}"/>
       <TextBox x:Name="HolyricsUrl" Watermark="http://192.168.1.10:8091" Text="http://127.0.0.1:8091"/>
       <TextBox x:Name="HolyricsToken" Watermark="Token da API" PasswordChar="●"/>
       <Button x:Name="HolyricsImportButton" Content="Baixar letras do Holyrics…" Classes="primary" HorizontalAlignment="Stretch"/>
       <ToggleSwitch x:Name="HolyricsFollowToggle" Content="Seguir apresentação"/>
       <TextBlock x:Name="HolyricsStatus" Text="Desconectado" TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource WsMuted}"/>
       <TextBlock Text="Também é possível importar TXT, JSON e OpenLyrics XML pelo botão Importar. Arquivos .hcb e .hcc não são suportados." TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource WsMuted}"/>
      </StackPanel></ScrollViewer>
     </TabItem>
     <TabItem Header="App">
      <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="10,16" Spacing="14">
       <TextBlock Text="PREFERÊNCIAS" Classes="caption"/>
       <TextBlock Text="Seu espaço de operação" FontSize="19" FontWeight="SemiBold"/>
       <TextBlock Text="Mude o tema no topo da janela. As preferências ficam salvas neste computador e não alteram as cores da projeção." TextWrapping="Wrap" Classes="muted" FontSize="12"/>
       <Border Height="1" Background="{DynamicResource WsBorder}"/>
       <TextBlock Text="COMPATIBILIDADE DOS FUNDOS" Classes="caption"/>
       <CheckBox x:Name="CompatibleVideoCheck" Content="Vídeos em modo econômico"/>
       <TextBlock Text="Reduz a resolução do vídeo de fundo para computadores mais simples. As letras continuam na resolução da projeção. Aplica imediatamente." TextWrapping="Wrap" Classes="muted" FontSize="11"/>
       <CheckBox x:Name="SoftwareRenderingCheck" Content="Renderização gráfica por software"/>
       <TextBlock Text="Use se os efeitos aparecem pretos ou não se movem neste computador. Requer reiniciar o aplicativo. A edição legado já usa software." TextWrapping="Wrap" Classes="muted" FontSize="11"/>
       <TextBlock x:Name="GraphicsCompatibilityStatus" Text="Vídeos e letras usam a mesma superfície de projeção." TextWrapping="Wrap" Classes="muted" FontSize="11"/>
       <Button x:Name="RestartGraphicsButton" Content="Reiniciar para aplicar" IsVisible="False" HorizontalAlignment="Stretch"/>
       <Border Height="1" Background="{DynamicResource WsBorder}"/>
       <TextBlock Text="ATUALIZAÇÕES" Classes="caption"/>
       <TextBlock x:Name="VersionLabel" FontWeight="SemiBold"/>
       <CheckBox x:Name="AutoUpdateCheck" Content="Buscar atualizações ao abrir" IsChecked="True"/>
       <TextBlock Text="Consulta as versões públicas do Letras para culto no GitHub. Sem internet, todas as funções de operação continuam disponíveis." TextWrapping="Wrap" Classes="muted" FontSize="11"/>
       <Button x:Name="CheckUpdatesButton" Content="Verificar atualizações" HorizontalAlignment="Stretch"/>
       <TextBlock x:Name="UpdateDetails" Text="Nenhuma consulta realizada nesta sessão." TextWrapping="Wrap" Classes="muted" FontSize="11"/>
       <Border Height="1" Background="{DynamicResource WsBorder}"/>
       <TextBlock Text="BIBLIOTECA LOCAL" Classes="caption"/>
       <Button x:Name="BackupButton" Content="Salvar backup completo" HorizontalAlignment="Stretch"/>
       <Button x:Name="RestoreButton" Content="Restaurar backup…" HorizontalAlignment="Stretch"/>
       <TextBlock Text="Inclui biblioteca, roteiro, cena e mídia. Faça um backup antes de operar em outro computador." TextWrapping="Wrap" Classes="muted" FontSize="11"/>
      </StackPanel></ScrollViewer>
     </TabItem>
    </TabControl>
     </Grid>
    </Grid>
   </Border>
  </Grid>
  <Border Grid.Row="3" Background="{DynamicResource WsHeader}" BorderBrush="{DynamicResource WsBorder}" BorderThickness="0,1,0,0">
   <Grid ColumnDefinitions="240,*,318">
    <TextBlock Text="W / LETRAS PARA CULTO" FontSize="9" FontWeight="SemiBold" LetterSpacing="1.2" VerticalAlignment="Center" Margin="14,0" Classes="muted"/>
    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
     <Button x:Name="OperationWorkspaceButton" Content="Operação" Classes="workspace active" FontWeight="SemiBold"/>
     <Button x:Name="AnimationsWorkspaceButton" Content="Animações" Classes="workspace"/>
     <Button x:Name="ConnectionsWorkspaceButton" Content="Conexões" Classes="workspace"/>
    </StackPanel>
    <TextBlock Grid.Column="2" Text="ARQUIVOS LOCAIS · SEM NUVEM" FontSize="9" Classes="subtle" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
   </Grid>
  </Border>
  <Border Grid.Row="4" Background="{DynamicResource WsSurface}" BorderBrush="{DynamicResource WsBorder}" BorderThickness="0,1,0,0" Padding="12,4"><Grid ColumnDefinitions="*,Auto"><TextBlock x:Name="StatusText" Text="Pronto" FontSize="9" Classes="muted" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="← → navegar · B tela preta · L letra · F11 projeção" FontSize="9" Classes="muted" Margin="10,0,0,0"/></Grid></Border>
 </Grid>
</Window>
