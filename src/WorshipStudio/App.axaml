<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="WorshipStudio.App" RequestedThemeVariant="Dark">
 <Application.Resources>
  <SolidColorBrush x:Key="WsBackground">#1D1E22</SolidColorBrush>
  <SolidColorBrush x:Key="WsSurface">#23252A</SolidColorBrush>
  <SolidColorBrush x:Key="WsPanel">#292B32</SolidColorBrush>
  <SolidColorBrush x:Key="WsInput">#17181C</SolidColorBrush>
  <SolidColorBrush x:Key="WsBorder">#40424C</SolidColorBrush>
  <SolidColorBrush x:Key="WsText">#EFF1F4</SolidColorBrush>
  <SolidColorBrush x:Key="WsMuted">#B2B8C2</SolidColorBrush>
  <SolidColorBrush x:Key="WsSubtle">#939DAA</SolidColorBrush>
  <SolidColorBrush x:Key="WsAccent">#EC7968</SolidColorBrush>
  <SolidColorBrush x:Key="WsAccentLabel">#FFA18F</SolidColorBrush>
  <SolidColorBrush x:Key="WsAccentText">#231412</SolidColorBrush>
  <SolidColorBrush x:Key="WsSelection">#443039</SolidColorBrush>
  <SolidColorBrush x:Key="WsHover">#343A42</SolidColorBrush>
  <SolidColorBrush x:Key="WsDanger">#462A33</SolidColorBrush>
  <SolidColorBrush x:Key="WsDangerText">#FFB4C1</SolidColorBrush>
  <SolidColorBrush x:Key="WsHeader">#18191D</SolidColorBrush>
  <SolidColorBrush x:Key="WsLive">#FF8298</SolidColorBrush>
  <SolidColorBrush x:Key="WsLiveText">#27191D</SolidColorBrush>
  <SolidColorBrush x:Key="WsSuccess">#A1DEB6</SolidColorBrush>
  <SolidColorBrush x:Key="WsShadow">#30000000</SolidColorBrush>
  <SolidColorBrush x:Key="WsClip">#344B60</SolidColorBrush>
  <SolidColorBrush x:Key="WsClipText">#E0EBF5</SolidColorBrush>
  <SolidColorBrush x:Key="WsClipAccent">#78B2D8</SolidColorBrush>
  <SolidColorBrush x:Key="WsTrackHeader">#22242A</SolidColorBrush>
  <SolidColorBrush x:Key="WsTimelineBg">#181A1F</SolidColorBrush>
  <SolidColorBrush x:Key="WsSetlistClip">#5C5441</SolidColorBrush>
  <SolidColorBrush x:Key="WsSetlistText">#FFF1CD</SolidColorBrush>
 </Application.Resources>
 <Application.Styles>
  <FluentTheme />
  <Style Selector="Window"><Setter Property="FontFamily" Value="Inter, Segoe UI"/><Setter Property="Background" Value="{DynamicResource WsBackground}"/><Setter Property="Foreground" Value="{DynamicResource WsText}"/></Style>
  <Style Selector="TextBlock"><Setter Property="FontSize" Value="12"/></Style>
  <Style Selector="Button"><Setter Property="CornerRadius" Value="4"/><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="12,6"/><Setter Property="Background" Value="{DynamicResource WsPanel}"/><Setter Property="Foreground" Value="{DynamicResource WsText}"/><Setter Property="BorderBrush" Value="{DynamicResource WsBorder}"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource WsHover}"/><Setter Property="Foreground" Value="{DynamicResource WsText}"/></Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource WsSelection}"/></Style>
  <Style Selector="Button.primary"><Setter Property="Background" Value="{DynamicResource WsAccent}"/><Setter Property="Foreground" Value="{DynamicResource WsAccentText}"/><Setter Property="BorderBrush" Value="{DynamicResource WsAccent}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource WsAccent}"/><Setter Property="Foreground" Value="{DynamicResource WsAccentText}"/><Setter Property="Opacity" Value="0.88"/></Style>
  <Style Selector="Button.danger"><Setter Property="Background" Value="{DynamicResource WsDanger}"/><Setter Property="Foreground" Value="{DynamicResource WsDangerText}"/></Style>
  <Style Selector="Button.flat"><Setter Property="Background" Value="Transparent"/></Style>
  <Style Selector="Button.nav"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/></Style>
  <Style Selector="Button.workspace"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="20,10"/><Setter Property="Foreground" Value="{DynamicResource WsMuted}"/></Style>
  <Style Selector="Button.workspace.active"><Setter Property="Background" Value="{DynamicResource WsSelection}"/><Setter Property="Foreground" Value="{DynamicResource WsAccentLabel}"/></Style>
  <Style Selector="Window.studio-shell Button"><Setter Property="MinHeight" Value="28"/><Setter Property="CornerRadius" Value="3"/><Setter Property="Padding" Value="10,5"/></Style>
  <Style Selector="Window.studio-shell Button.workspace"><Setter Property="MinHeight" Value="40"/><Setter Property="Padding" Value="25,8"/><Setter Property="CornerRadius" Value="0"/></Style>
  <Style Selector="Menu"><Setter Property="Background" Value="{DynamicResource WsHeader}"/><Setter Property="Foreground" Value="{DynamicResource WsText}"/></Style>
  <Style Selector="MenuItem"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="{DynamicResource WsText}"/></Style>
  <Style Selector="TextBox"><Setter Property="CornerRadius" Value="4"/><Setter Property="Background" Value="{DynamicResource WsInput}"/><Setter Property="Foreground" Value="{DynamicResource WsText}"/><Setter Property="BorderBrush" Value="{DynamicResource WsBorder}"/><Setter Property="MinHeight" Value="32"/><Setter Property="SelectionBrush" Value="{DynamicResource WsSelection}"/></Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement"><Setter Property="BorderBrush" Value="{DynamicResource WsAccent}"/></Style>
  <Style Selector="ComboBox"><Setter Property="CornerRadius" Value="4"/><Setter Property="Background" Value="{DynamicResource WsInput}"/><Setter Property="Foreground" Value="{DynamicResource WsText}"/><Setter Property="BorderBrush" Value="{DynamicResource WsBorder}"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="MinHeight" Value="32"/></Style>
  <Style Selector="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource WsText}"/></Style>
  <Style Selector="NumericUpDown"><Setter Property="Background" Value="{DynamicResource WsInput}"/><Setter Property="Foreground" Value="{DynamicResource WsText}"/><Setter Property="BorderBrush" Value="{DynamicResource WsBorder}"/><Setter Property="CornerRadius" Value="4"/></Style>
  <Style Selector="CheckBox"><Setter Property="Foreground" Value="{DynamicResource WsText}"/></Style>
  <Style Selector="ToggleSwitch"><Setter Property="Foreground" Value="{DynamicResource WsText}"/></Style>
  <Style Selector="TextBlock.caption"><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="LetterSpacing" Value="1.3"/><Setter Property="Foreground" Value="{DynamicResource WsMuted}"/></Style>
  <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource WsMuted}"/></Style>
  <Style Selector="TextBlock.subtle"><Setter Property="Foreground" Value="{DynamicResource WsSubtle}"/></Style>
  <Style Selector="Border.panel"><Setter Property="Background" Value="{DynamicResource WsPanel}"/><Setter Property="CornerRadius" Value="5"/><Setter Property="BorderBrush" Value="{DynamicResource WsBorder}"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style Selector="Border.surface"><Setter Property="Background" Value="{DynamicResource WsSurface}"/><Setter Property="BorderBrush" Value="{DynamicResource WsBorder}"/></Style>
  <Style Selector="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource WsText}"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style Selector="ListBoxItem"><Setter Property="Padding" Value="10,9"/><Setter Property="Margin" Value="0,2"/><Setter Property="CornerRadius" Value="4"/><Setter Property="Foreground" Value="{DynamicResource WsText}"/></Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource WsSelection}"/><Setter Property="Foreground" Value="{DynamicResource WsText}"/></Style>
  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource WsHover}"/></Style>
  <Style Selector="TabControl"><Setter Property="Background" Value="{DynamicResource WsSurface}"/></Style>
  <Style Selector="TabItem"><Setter Property="Foreground" Value="{DynamicResource WsMuted}"/><Setter Property="Padding" Value="12,9"/><Setter Property="FontSize" Value="11"/></Style>
  <Style Selector="TabItem:selected"><Setter Property="Foreground" Value="{DynamicResource WsAccentLabel}"/></Style>
  <Style Selector="ToolTip"><Setter Property="Background" Value="{DynamicResource WsPanel}"/><Setter Property="Foreground" Value="{DynamicResource WsText}"/><Setter Property="BorderBrush" Value="{DynamicResource WsBorder}"/></Style>
  <Style Selector="MenuFlyoutPresenter"><Setter Property="Background" Value="{DynamicResource WsPanel}"/><Setter Property="Foreground" Value="{DynamicResource WsText}"/><Setter Property="BorderBrush" Value="{DynamicResource WsBorder}"/></Style>
 </Application.Styles>
</Application>
